<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<jsp:include page="includes/header.jsp" />
<section class="page-heading"><div><p class="eyebrow">Records</p><h1>Transactions</h1></div><a class="button" href="<c:url value='/transactions/add'/>">+ Add transaction</a></section>
<c:if test="${param.msg == 'added'}"><p class="notice">Transaction added.</p></c:if><c:if test="${param.msg == 'updated'}"><p class="notice">Transaction updated.</p></c:if><c:if test="${param.msg == 'deleted'}"><p class="notice">Transaction deleted.</p></c:if>
<form class="filter-form panel" method="get" action="<c:url value='/transactions'/>"><fieldset><legend>Filter transactions</legend><label>Type<select name="type"><option value="">All types</option><option value="INCOME" <c:if test="${param.type == 'INCOME'}">selected</c:if>>Income</option><option value="EXPENSE" <c:if test="${param.type == 'EXPENSE'}">selected</c:if>>Expense</option></select></label><label>Category<select name="categoryId"><option value="">All categories</option><c:forEach items="${categories}" var="category"><option value="<c:out value='${category.id}'/>" <c:if test="${param.categoryId == category.id}">selected</c:if>><c:out value="${category.name}"/></option></c:forEach></select></label><label>From<input type="date" name="from" value="<c:out value='${param.from}'/>"></label><label>To<input type="date" name="to" value="<c:out value='${param.to}'/>"></label><button type="submit">Apply filters</button><a href="<c:url value='/transactions'/>">Clear</a></fieldset></form>
<c:if test="${not empty filterError}"><p class="field-error"><c:out value="${filterError}"/></p></c:if>
<section class="panel"><c:choose><c:when test="${empty transactions}"><p>No transactions match these filters. <a href="<c:url value='/transactions/add'/>">Add one.</a></p></c:when><c:otherwise><div class="table-scroll"><table><thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Description</th><th>Amount</th><th>Actions</th></tr></thead><tbody><c:forEach items="${transactions}" var="transaction"><tr><td><c:out value="${transaction.transactionDate}"/></td><td><c:out value="${transaction.type}"/></td><td><c:out value="${transaction.category.name}"/></td><td><c:out value="${transaction.description}"/></td><td><c:choose><c:when test="${transaction.type == 'INCOME'}">+ </c:when><c:otherwise>− </c:otherwise></c:choose>₹<fmt:formatNumber value="${transaction.amount}" minFractionDigits="2" maxFractionDigits="2"/></td><td><a href="<c:url value='/transactions/edit'><c:param name='id' value='${transaction.id}'/></c:url>">Edit</a> · <a href="<c:url value='/transactions/delete'><c:param name='id' value='${transaction.id}'/></c:url>">Delete</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<jsp:include page="includes/footer.jsp" />
