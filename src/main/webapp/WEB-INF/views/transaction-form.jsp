<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="includes/header.jsp" />
<c:set var="editing" value="${not empty transaction or editing}"/>
<section class="page-heading"><div><p class="eyebrow">Transaction</p><h1><c:choose><c:when test="${editing}">Edit transaction</c:when><c:otherwise>Add transaction</c:otherwise></c:choose></h1></div></section>
<form class="panel form-card" method="post" action="<c:choose><c:when test='${editing}'><c:url value='/transactions/edit'><c:param name='id' value='${transaction.id}'/></c:url></c:when><c:otherwise><c:url value='/transactions/add'/></c:otherwise></c:choose>">
    <fieldset><legend>Details</legend>
        <label for="amount">Amount</label><input id="amount" name="amount" type="text" inputmode="decimal" required value="<c:choose><c:when test='${not empty form}'><c:out value='${form.amount}'/></c:when><c:otherwise><c:out value='${transaction.amount}'/></c:otherwise></c:choose>"><c:if test="${not empty form.errors.amount}"><span class="field-error"><c:out value="${form.errors.amount}"/></span></c:if>
        <label for="type">Type</label><select id="type" name="type" required><option value="">Choose type</option><option value="INCOME" <c:if test="${form.type == 'INCOME' or (empty form and transaction.type == 'INCOME')}">selected</c:if>>Income</option><option value="EXPENSE" <c:if test="${form.type == 'EXPENSE' or (empty form and transaction.type == 'EXPENSE')}">selected</c:if>>Expense</option></select><c:if test="${not empty form.errors.type}"><span class="field-error"><c:out value="${form.errors.type}"/></span></c:if>
        <label for="categoryId">Category</label><select id="categoryId" name="categoryId" required><option value="">Choose category</option><c:forEach items="${categories}" var="category"><option value="<c:out value='${category.id}'/>" <c:if test="${form.categoryId == category.id or (empty form and transaction.category.id == category.id)}">selected</c:if>><c:out value="${category.name}"/></option></c:forEach></select><c:if test="${not empty form.errors.category}"><span class="field-error"><c:out value="${form.errors.category}"/></span></c:if>
        <label for="transactionDate">Date</label><input id="transactionDate" name="transactionDate" type="date" required value="<c:choose><c:when test='${not empty form}'><c:out value='${form.transactionDate}'/></c:when><c:otherwise><c:out value='${transaction.transactionDate}'/></c:otherwise></c:choose>"><c:if test="${not empty form.errors.date}"><span class="field-error"><c:out value="${form.errors.date}"/></span></c:if>
        <label for="description">Description <span class="muted">optional, up to 255 characters</span></label><textarea id="description" name="description" maxlength="255"><c:choose><c:when test="${not empty form}"><c:out value="${form.description}"/></c:when><c:otherwise><c:out value="${transaction.description}"/></c:otherwise></c:choose></textarea><c:if test="${not empty form.errors.description}"><span class="field-error"><c:out value="${form.errors.description}"/></span></c:if>
        <button class="button" type="submit"><c:choose><c:when test="${editing}">Save changes</c:when><c:otherwise>Add transaction</c:otherwise></c:choose></button> <a href="<c:url value='/transactions'/>">Cancel</a>
    </fieldset>
</form>
<jsp:include page="includes/footer.jsp" />
